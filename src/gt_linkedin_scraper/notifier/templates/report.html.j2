<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Scraper Report</title></head>
<body>
  <h2>LinkedIn Job Scraper Report</h2>
  <p><strong>Keyword:</strong> {{ keyword }}</p>
  <p><strong>Tag:</strong> {{ tag }}</p>
  <p><strong>Date:</strong> {{ date }}</p>
  <p><strong>Records Extracted:</strong> {{ records_count }}</p>
  <p><strong>Recipients:</strong> {{ recipients|join(", ") }}</p>
  <p>Please find the attached CSV files for this run.</p>
</body>
</html>
