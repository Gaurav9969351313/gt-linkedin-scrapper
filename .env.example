# Copy to .env and fill in. Values below work for local development against
# the Docker infrastructure; inside docker-compose the DB/Prefect hosts and
# runtime paths are overridden automatically.

# ---- Database ----
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_pass
POSTGRES_DB=scraper_db
# Async driver: scraper API, Prefect flows, Alembic
DATABASE_URL=postgresql+asyncpg://scraper:scraper_pass@localhost:5432/scraper_db
# Sync driver: Streamlit app, web app API, scripts
DATABASE_URL_SYNC=postgresql+psycopg2://scraper:scraper_pass@localhost:5432/scraper_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- LinkedIn account used by the scraper ----
LINKEDIN_USERNAME=you@example.com
LINKEDIN_PASSWORD=change-me

# ---- SMTP (scrape reports, invitations, approval emails) ----
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=you@example.com

# ---- Prefect ----
PREFECT_API_URL=http://localhost:4200/api

# ---- App ----
LOG_LEVEL=INFO
LOG_FORMAT=json
JOBS_CONFIG_PATH=config/jobs.yaml

# ---- Runtime files (all under runtime/, git-ignored) ----
AUTH_STATE_PATH=runtime/data/auth_state.json
# RESUME_UPLOAD_DIR=runtime/resumes
# LOG_DIR=runtime/logs
# EXTRACT_DIR=runtime/extract
# DEBUG_DIR=runtime/debug

# ---- Web app (Angular UI on :8502) ----
# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, everyone is signed out whenever the web container restarts.
WEB_SECRET_KEY=
# Base URL put in invitation links (use your real domain in production).
WEB_PUBLIC_URL=http://localhost:8502
# WEB_TOKEN_TTL=43200
# WEB_INVITE_TTL_DAYS=7

# ---- Scrape report recipients per tag (comma-separated) ----
TAG_RECIPIENTS__DEVOPS=
TAG_RECIPIENTS__JAVA=
TAG_RECIPIENTS__QA=
TAG_RECIPIENTS__FRESHERS=
TAG_RECIPIENTS__DATA_ENGINEER=
TAG_RECIPIENTS__DEFAULT=you@example.com
