{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (FastAPI)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/Scripts/uvicorn.exe",
      "args": [
        "gt_linkedin_scraper.api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Run Job Directly",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_job_directly.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Run Worker",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_worker.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Seed Jobs",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_jobs.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Run Web API",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "gt_linkedin_scraper.web.app:app",
        "--port",
        "8502",
        "--reload",
        "--reload-dir",
        "src"
      ],
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}
