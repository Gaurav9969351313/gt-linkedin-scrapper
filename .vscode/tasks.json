{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/uvicorn.exe",
      "args": [
        "gt_linkedin_scraper.api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Worker",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/start_worker.py"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Job Directly",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "run_job_directly.py"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Seed Jobs",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/seed_jobs.py"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Check Job Status",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-c",
        "from sqlalchemy.ext.asyncio import create_async_engine; from sqlalchemy import text; import asyncio; async def main(): engine = create_async_engine('postgresql+asyncpg://scraper:scraper_pass@localhost:5432/scraper_db'); async with engine.connect() as conn: result = await conn.execute(text('SELECT id, status, keyword FROM jobs ORDER BY id')); rows = result.fetchall(); print(f'Jobs: {len(rows)}'); [print(f'  {row}') for row in rows]; asyncio.run(main())"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
